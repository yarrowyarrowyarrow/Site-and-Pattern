env/

# Database (auto-created on first run)
data/permadesign.db
plants.db

# USDA download artifact (created by import_usda.py)
data/usda_plants_raw.txt

# Generated plant catalogue (regenerate from plants_master.json via
# scripts/export_plant_docx.py — not tracked)
/plant_data.docx

# Build-time version stamp (written by build_installer.sh/.bat for the
# frozen app's in-app updater; regenerated on every build)
version.txt

# Editor / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Autosave
*.perma.geojson.bak

# F125 fauna sourcing (V2.58). The fetcher's resume file holds a second copy of
# every edge plus the done-list, so committing it doubles the data for nothing —
# it exists only so a Ctrl-C can pick up where it stopped. The two OUTPUT files
# beside it (fauna_edges_candidates.json, fauna_new_species.json) ARE committed:
# they are the evidence a seeded edge is real, and the ingester reads them.
data/fetched/_checkpoint.json
data/fetched/_checkpoint_obs.json
data/fetched/*.tmp
